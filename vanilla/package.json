{
  "name": "structnova-vanilla",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:css:watch\" \"npm:serve\"",
    "serve": "http-server public -p 5173 -c-1 -s",
    "css": "tailwindcss -i ./src/input.css -o ./public/css/output.css",
    "css:watch": "tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./public/css/output.css --minify"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "http-server": "^14.1.1",
    "tailwindcss": "^3.4.14",
    "@tailwindcss/forms": "^0.5.9"
  }
}
